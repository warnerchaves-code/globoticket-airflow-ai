# Copy of the shape that scripts/1_provision_azure.sh generates as `.env`.
#
# You do NOT need to fill this in by hand. Run the script and it writes the real `.env`
# for you, with the model endpoint and key read from Azure and a generated PostgreSQL
# password, API token and Fernet key.
#
# This file exists so you can see what ends up in `.env` without having to run anything,
# and so you know exactly which values are secrets.
#
# `.env` is git-ignored. Keep it that way. STORAGE_KEY, OAI_KEY, PG_PASSWORD, FERNET_KEY
# and GLOBOTICKET_API_TOKEN are live credentials.

AZ_SUBSCRIPTION=00000000-0000-0000-0000-000000000000
AZ_LOCATION=canadacentral
AZ_RESOURCE_GROUP=rg-globoticket-ai

STORAGE_ACCOUNT=stgloboaixxxxxx
STORAGE_KEY=<secret - storage account key>
STORAGE_CONTAINER=globoticket-intake

# The v1 endpoint is used, so the Connection needs no API version
OAI_ENDPOINT=https://oai-globoticket-xxxxxx.openai.azure.com/openai/v1
OAI_KEY=<secret - Azure OpenAI key>
OAI_DEPLOYMENT=gpt-4.1-mini

VM_NAME=vm-airflow
VM_PUBLIC_IP=0.0.0.0
VM_PRIVATE_IP=10.42.1.4
VM_USER=azureuser
VM_SSH_KEY=./globoticket_vm_key
AIRFLOW_URL=http://0.0.0.0:8080

# The event catalog: PostgreSQL in a container on the VM
PG_DATABASE=globoticket
PG_USER=globo
PG_PASSWORD=<secret - generated>

ALLOWED_IP=0.0.0.0

# Consumed by docker-compose on the VM
AIRFLOW_UID=50000
FERNET_KEY=<secret - generated>
GLOBOTICKET_API_TOKEN=<secret - generated>
